    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.43",
    "koa": "^3.2.1",
    "pino": "^10.3.1",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
