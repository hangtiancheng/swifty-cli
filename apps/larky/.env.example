# Larky Environment Configuration
# Copy this file to .env and fill in your values.
# All variables are optional; defaults are used when unset.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: Override API base URL ---
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Daemon ---
# LARKY_HOST=127.0.0.1
# LARKY_PORT=5520

# --- Logging ---
# LARKY_LOG_LEVEL=INFO
# LARKY_LOG_FILE=~/.larky/logs/core.log
# LARKY_LOG_FORMAT=text

# --- Agent ---
# LARKY_MAX_STEPS=20

# --- LLM ---
# LARKY_LLM_DEFAULT_MODEL=claude-sonnet-4-6

# --- Tracing ---
# LARKY_TRACE_ENABLED=true
# LARKY_TRACE_FILE=~/.larky/traces/daemon.jsonl
# LARKY_TRACE_INCLUDE_LLM_PAYLOAD=true

# --- Permissions ---
# LARKY_PERMISSION_TIMEOUT_S=60

# --- Compaction ---
# LARKY_COMPACT_THRESHOLD=0.0
# LARKY_COMPACT_TOOL_LIMIT=8000
# LARKY_COMPACT_TOOL_KEEP=4000

# --- Config file override ---
# LARKY_CONFIG=~/.larky/config.toml
