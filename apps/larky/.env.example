# Larky Environment Configuration
# Copy this file to .env and fill in your values.
#
# Precedence (lowest to highest):
#   built-in defaults < ~/.larky/config.yaml (global) < .larky/config.yaml (project) < real environment variables
#
# Every variable is OPTIONAL and falls back to its default (or the config.yaml
# value) when unset. Invalid values fail validation and exit at startup.
# Schema source: src/core/config.ts (applyEnv)

# --- API credentials ---
# optional, string, default: "" (falls back to providers[].api_key in config.yaml).
# The Anthropic API key must be provided in at least one of the two places,
# otherwise LLM calls fail at startup with "Anthropic API key not set".
ANTHROPIC_API_KEY=sk-

# --- Daemon ([core]) ---
# optional, string, default: "127.0.0.1" — daemon listen address
# LARKY_HOST=127.0.0.1
# optional, integer, default: 5520 — daemon listen port
# LARKY_PORT=5520

# --- Tracing ([trace]) ---
# optional, boolean, default: true — "0"/"false"/"no" (case-insensitive) mean
# false, any other value means true
# LARKY_TRACE_ENABLED=true
# optional, string, default: "~/.larky/traces/daemon.jsonl" — trace output file
# LARKY_TRACE_FILE=~/.larky/traces/daemon.jsonl

# --- Config file override ---
# optional, string, default: unset — when set, ONLY this YAML file is loaded
# (the global ~/.larky/config.yaml and project .larky/config.yaml are skipped)
# LARKY_CONFIG=~/.larky/config.yaml
