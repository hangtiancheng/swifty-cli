# Larky Environment Configuration
# Copy this file to .env and fill in your values.
#
# Precedence (lowest to highest):
#   built-in defaults < ~/.larky/config.toml (global) < .larky/config.toml (project) < .env < real environment variables
# .env is loaded via dotenv with override:false — variables already set in the
# real environment always win over .env values.
#
# Every variable is OPTIONAL and falls back to its default (or the config.toml
# value) when unset. Invalid values fail validation and exit at startup.
# Schema source: src/core/config.ts (applyEnv)

# --- API credentials ---
# optional, string, default: "" (falls back to llm.api_key in config.toml).
# The Anthropic API key must be provided in at least one of the two places,
# otherwise LLM calls fail at startup with "Anthropic API key not set".
ANTHROPIC_API_KEY=sk-

# optional, string, default: "" (falls back to llm.base_url in config.toml;
# empty means the Anthropic SDK default endpoint)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- Daemon ([core]) ---
# optional, string, default: "127.0.0.1" — daemon listen address
# LARKY_HOST=127.0.0.1
# optional, integer, default: 5520 — daemon listen port
# LARKY_PORT=5520

# --- Logging ([logging]) ---
# optional, string, default: "INFO" — log level
# LARKY_LOG_LEVEL=INFO
# optional, string, default: "~/.larky/logs/core.log" — log file path
# LARKY_LOG_FILE=~/.larky/logs/core.log
# optional, string, default: "text" — "text" or "json"
# LARKY_LOG_FORMAT=text

# --- Agent ([agent]) ---
# optional, positive integer, default: 20 — maximum agent steps per task
# LARKY_MAX_STEPS=20

# --- LLM ([llm]) ---
# optional, string, default: "claude-sonnet-4-6" — default model
# LARKY_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# Note: llm.router has no environment variable override (config.toml only).

# --- Tracing ([trace]) ---
# optional, boolean, default: true — "0"/"false"/"no" (case-insensitive) mean
# false, any other value means true
# LARKY_TRACE_ENABLED=true
# optional, string, default: "~/.larky/traces/daemon.jsonl" — trace output file
# LARKY_TRACE_FILE=~/.larky/traces/daemon.jsonl
# optional, boolean, default: true — include LLM request/response payloads
# ("0"/"false"/"no" mean false)
# LARKY_TRACE_INCLUDE_LLM_PAYLOAD=true

# --- Permissions ([permission]) ---
# optional, number >= 0, default: 60 — permission prompt timeout in seconds
# LARKY_PERMISSION_TIMEOUT_S=60

# --- Compaction ([compaction]) ---
# optional, number in [0, 1], default: 0.0 (disabled) — auto-compaction threshold
# LARKY_COMPACT_THRESHOLD=0.0
# optional, positive integer, default: 8000 — truncate tool results longer than this
# LARKY_COMPACT_TOOL_LIMIT=8000
# optional, positive integer, default: 4000 — length retained after truncation
# LARKY_COMPACT_TOOL_KEEP=4000

# --- Config file override ---
# optional, string, default: unset — when set, ONLY this TOML file is loaded
# (the global ~/.larky/config.toml and project .larky/config.toml are skipped)
# LARKY_CONFIG=~/.larky/config.toml
