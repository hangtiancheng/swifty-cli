{
  "name": "swifty-cli",
  "version": "0.0.1",
  "description": "swifty cli",
  "private": true,
  "scripts": {
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:commit:n": "git add -A && git commit -m \"feat: Introduce new features\" --no-verify",
    "git:push": "pnpm git:commit && git push origin main",
    "git:push:n": "pnpm git:commit:n && git push origin main",
    "format:sh": "shfmt -w ./install.sh ./larky.sh ./swiftx.sh",
    "format": "concurrently \"pnpm format:swifty\" \"pnpm format:swiftx\"",
    "format:swifty": "pnpm --filter @swifty.js/swifty format",
    "format:swiftx": "pnpm --filter @swifty.js/swiftx format",
    "build": "concurrently \"pnpm build:swifty\" \"pnpm build:swiftx\"",
    "build:swifty": "pnpm --filter @swifty.js/swifty build",
    "build:swiftx": "pnpm --filter @swifty.js/swiftx build",
    "build:wasm": "pnpm --filter @swifty.js/glob-wasm build",
    "build:marked-terminal": "pnpm --filter @swifty.js/marked-terminal build",
    "prebuild": "concurrently \"pnpm build:wasm\" \"pnpm build:marked-terminal\"",
    "prepare": "husky"
  },
  "keywords": [],
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0"
  },
  "lint-staged": {
    "apps/swifty/**/*.{json,jsonc,js,cjs,mjs,jsx,ts,cts,mts,tsx,html,vue,css,scss,md,mdx}": [
      "pnpm --filter @swifty.js/swifty format"
    ]
  },
  "author": "https://github.com/hangtiancheng",
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "@swifty.js/swifty": "workspace:*",
      "@swifty.js/swiftx": "workspace:*"
    }
  }
}
